{
  "id": "dida365",
  "name": { "zh-CN": "滴答清单", "en": "TickTick" },
  "icon": "ticktick",
  "description": { "zh-CN": "待办任务列表、按清单添加、勾选完成与改到期日", "en": "Task list, per-list quick add, completion and due-date editing" },
  "version": "0.2.2",
  "apiVersion": 1,
  "runtime": { "command": "dida365.exe" },
  "permissions": ["network", "sessions"],
  "contributes": ["sessions"],
  "settings": [
    {
      "key": "token",
      "label": { "zh-CN": "API 口令", "en": "API token" },
      "type": "secret",
      "default": ""
    },
    {
      "key": "interval",
      "label": { "zh-CN": "刷新间隔", "en": "Refresh interval" },
      "type": "select",
      "default": "180",
      "options": [
        { "value": "60", "label": { "zh-CN": "1 分钟", "en": "1 minute" } },
        { "value": "180", "label": { "zh-CN": "3 分钟", "en": "3 minutes" } },
        { "value": "600", "label": { "zh-CN": "10 分钟", "en": "10 minutes" } }
      ]
    }
  ],
  "actions": [
    { "id": "test", "label": { "zh-CN": "测试连接", "en": "Test connection" } }
  ]
}
